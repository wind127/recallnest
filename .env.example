# Optional model connection. Keep real values in your local environment or app settings.
# The app can import, search and review manually without a model.
# Uncomment only fields you want the environment to control on startup.
# An explicitly empty value overrides and clears that saved UI setting.
# RECALLNEST_BASE_URL=http://127.0.0.1:11434/v1
# RECALLNEST_CHAT_MODEL=your-chat-model
# RECALLNEST_API_KEY=your-local-secret
# RECALLNEST_EMBEDDING_MODEL=your-embedding-model

# Source installs default to ~/.recallnest; Compose uses its /data named volume.
# Never commit this directory.
# RECALLNEST_DATA_DIR=/absolute/path/to/your/private/recallnest-data

# Optional positive import limits, in bytes / member count.
# RECALLNEST_MAX_UPLOAD_BYTES=33554432
# RECALLNEST_MAX_ZIP_BYTES=134217728
# RECALLNEST_MAX_ZIP_MEMBERS=1000
